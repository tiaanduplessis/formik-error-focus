{
  "name": "formik-error-focus",
  "version": "2.0.0",
  "description": "Scroll to the first error in your Formik form and set focus",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "scripts": {
    "test": "npm run build && node --test test/*.test.cjs",
    "coverage": "npm run build && node --test --experimental-test-coverage test/*.test.cjs",
    "build": "rm -rf dist && tsup src/index.tsx --format cjs,esm --dts --target es2018",
    "prepublishOnly": "npm run build",
    "types:check": "tsc --noEmit",
    "format": "pretty-quick --ignore-path .gitignore",
    "format:check": "prettier --check src test package.json tsconfig.json README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiaanduplessis/formik-error-focus.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "formik",
    "errors",
    "scroll",
    "scroll-to",
    "focus"
  ],
  "author": "Tiaan du Plessis <tiaanduplessis@hotmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tiaanduplessis/formik-error-focus/issues"
  },
  "homepage": "https://github.com/tiaanduplessis/formik-error-focus#readme",
  "devDependencies": {
    "@types/flat": "^5.0.2",
    "@types/hoist-non-react-statics": "3.3.7",
    "@types/react": "18.3.31",
    "@types/scroll-to-element": "^2.0.2",
    "formik": "2.4.9",
    "jsdom": "22.1.0",
    "prettier": "3.9.9",
    "pretty-quick": "4.2.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-select": "5.10.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "formik": ">= 1",
    "react": ">= 16.3"
  },
  "dependencies": {
    "flat": "^5.0.2",
    "scroll-to-element": "^2.0.3"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
